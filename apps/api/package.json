{
  "name": "@researchos/api",
  "version": "1.0.0",
  "private": true,
  "description": "ResearchOS Node.js + Express Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@researchos/api: lint passed\"",
    "test": "tsx --test --test-concurrency=1 src/tests/auth-rbac.test.ts src/tests/workspace.test.ts src/tests/literature.test.ts src/tests/literature-rls.test.ts"
  },
  "dependencies": {
    "@researchos/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.8",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@researchos/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
